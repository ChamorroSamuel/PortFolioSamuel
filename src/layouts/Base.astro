---
import '@fontsource-variable/antonio';
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import CommandPalette from '../components/CommandPalette.astro';
import { otherLang, u, useT, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  /** Ruta equivalente en el otro idioma */
  altHref: string;
  title?: string;
  description?: string;
}

const { lang, altHref, title, description } = Astro.props;
const t = useT(lang);
const pageTitle = title ? `${title} · Samuel Chamorro` : t('meta.title');
const desc = description ?? t('meta.description');
const canonical = new URL(Astro.url.pathname, Astro.site);
const alternate = new URL(altHref, Astro.site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={lang} href={canonical} />
    <link rel="alternate" hreflang={otherLang(lang)} href={alternate} />
    <link rel="icon" type="image/png" href={u('/favicon.png')} />
    <meta name="theme-color" content="#0a0e13" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'es' ? 'es_PE' : 'en_US'} />
    <meta name="generator" content={Astro.generator} />
    <!-- Para la transición entre páginas: no pintar hasta tener el contenido principal -->
    <link rel="expect" href="#main" blocking="render" />
  </head>
  <body>
    <a class="skip" href="#main">{t('skip')}</a>
    <Nav lang={lang} altHref={altHref} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    <CommandPalette lang={lang} altHref={altHref} />
    <script>
      import { initCopyButtons, initNav, initPalette } from '../scripts/ui';
      initNav();
      initPalette();
      initCopyButtons();
    </script>
  </body>
</html>
