---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { site } from '../data/site';
import { paths, sectionIds, slugOf, useT, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  projects: CollectionEntry<'projects'>[];
}
const { lang, projects } = Astro.props;
const t = useT(lang);
const total = String(projects.length).padStart(2, '0');
---

<section class="projects" id={sectionIds[lang].projects} data-projects aria-labelledby="projects-title">
  <div class="projects-head wrap">
    <div class="titles">
      <p class="eyebrow">{t('projects.eyebrow')}</p>
      <h2 id="projects-title" class="display" data-fog>{t('projects.title')}</h2>
    </div>
    <p class="count" aria-hidden="true"><span data-count>01</span> / {total}</p>
  </div>

  <div class="track-wrap">
    <ul class="track" data-track>
      {
        projects.map((p, i) => {
          const slug = slugOf(p.id);
          return (
            <li class="card" data-card data-tilt>
              <a class="card-link" href={paths.project(lang, slug)}>
                <div class="card-inner" data-tilt-inner>
                  <div class={`card-media fit-${p.data.coverFit}`} style={`view-transition-name: media-${slug}`}>
                    <Image
                      src={p.data.cover}
                      alt={p.data.coverAlt}
                      widths={[480, 800, 1120]}
                      sizes="(max-width: 700px) 80vw, 560px"
                      loading={i < 2 ? 'eager' : 'lazy'}
                    />
                    <span class="glare" aria-hidden="true" />
                  </div>
                  <div class="card-info">
                    <p class="card-meta">
                      <span>{p.data.platform}</span>
                      <span>{p.data.stack.join(' · ')}</span>
                    </p>
                    <h3 style={`view-transition-name: title-${slug}`}>{p.data.title}</h3>
                    <p class="card-summary">{p.data.summary}</p>
                    <span class="card-cta">
                      {t('projects.open')} <span aria-hidden="true">→</span>
                    </span>
                  </div>
                </div>
              </a>
            </li>
          );
        })
      }
      <li class="card card-end">
        <a href={site.github} target="_blank" rel="noopener">
          <span class="end-title">GitHub</span>
          <span class="end-text">{t('projects.more')} <span aria-hidden="true">↗</span></span>
        </a>
      </li>
    </ul>
  </div>

  <div class="wrap">
    <div class="progress" aria-hidden="true"><i data-progress></i></div>
  </div>
</section>

<style>
  .projects {
    position: relative;
    padding-block: clamp(96px, 12vw, 160px) 40px;
    display: grid;
    /* minmax(0,1fr): la cinta es más ancha que la pantalla y no debe ensanchar la columna */
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(28px, 4vw, 48px);
  }
  .projects:global(.is-pinned) {
    height: 100svh;
    padding-block: calc(var(--nav-h) + 12px) 28px;
    grid-template-rows: auto minmax(0, 1fr) auto;
    gap: clamp(14px, 3vh, 32px);
    overflow: hidden;
  }
  .projects-head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 24px;
  }
  .titles {
    display: grid;
    gap: 14px;
  }
  .projects:global(.is-pinned) .display {
    font-size: clamp(3rem, min(9vw, 13vh), 8rem);
  }
  .count {
    font-family: var(--f-mono);
    font-size: 14px;
    color: var(--fog);
    font-variant-numeric: tabular-nums;
    padding-bottom: 6px;
  }
  .count span {
    color: var(--sodium);
  }

  /* Sin animación: carrusel con scroll lateral */
  .track-wrap {
    min-width: 0;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .track-wrap::-webkit-scrollbar {
    display: none;
  }
  .projects:global(.is-pinned) .track-wrap {
    overflow: visible;
    min-height: 0;
    display: flex;
    align-items: center;
  }
  .track {
    list-style: none;
    margin: 0;
    display: flex;
    align-items: stretch;
    gap: clamp(18px, 2.4vw, 36px);
    width: max-content;
    padding-block: 12px;
    padding-left: max(var(--gutter), calc((100vw - var(--maxw)) / 2 + var(--gutter)));
    padding-right: var(--gutter);
    will-change: transform;
  }
  .card {
    flex: none;
    width: clamp(260px, min(78vw, calc((100svh - 470px) * 1.3)), 560px);
    scroll-snap-align: start;
  }
  .card-link {
    display: block;
    text-decoration: none;
    color: inherit;
    border-radius: 16px;
  }
  .card-inner {
    display: grid;
    gap: 18px;
    transform: perspective(1100px) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
    transition: transform 0.7s var(--ease);
  }
  .card-inner:global(.is-tilting) {
    transition: transform 0.12s linear;
  }
  .card-media {
    position: relative;
    aspect-ratio: 4 / 3;
    border-radius: 14px;
    overflow: hidden;
    background: var(--asphalt);
    box-shadow: 0 30px 60px -20px rgba(0, 0, 0, 0.7);
  }
  .card-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    transition: transform 0.9s var(--ease);
  }
  .card-link:hover .card-media img {
    transform: scale(1.04);
  }
  .fit-contain {
    background: radial-gradient(80% 80% at 50% 45%, #2b2a24, var(--asphalt));
  }
  .fit-contain img {
    object-fit: contain;
    object-position: center;
    padding: 7%;
  }
  .glare {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(circle at var(--gx, 50%) var(--gy, 0%), rgba(255, 255, 255, 0.3), transparent 55%);
    mix-blend-mode: soft-light;
    opacity: 0;
    transition: opacity 0.4s;
  }
  .card-inner:global(.is-tilting) .glare {
    opacity: 1;
  }
  .card-info {
    display: grid;
    gap: 8px;
  }
  .card-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 14px;
    font-family: var(--f-mono);
    font-size: 11.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fog-dim);
  }
  .card-meta span:first-child {
    color: var(--sodium);
  }
  h3 {
    font-family: var(--f-display);
    font-weight: 700;
    text-transform: uppercase;
    font-size: clamp(1.8rem, 3vw, 2.6rem);
    line-height: 0.95;
    width: fit-content;
  }
  .card-summary {
    color: var(--fog);
    font-size: 15.5px;
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .card-cta {
    font-size: 14px;
    font-weight: 600;
    color: var(--bone);
  }
  .card-link:hover .card-cta {
    color: var(--sodium);
  }
  .card-end {
    width: clamp(220px, 26vw, 340px);
    display: flex;
  }
  .card-end a {
    flex: 1;
    display: grid;
    align-content: center;
    gap: 12px;
    padding: 28px;
    border: 1px dashed var(--line);
    border-radius: 14px;
    text-decoration: none;
    transition: border-color 0.3s, background-color 0.3s;
  }
  .card-end a:hover {
    border-color: var(--sodium);
    background: var(--sodium-soft);
  }
  .end-title {
    font-family: var(--f-display);
    font-weight: 700;
    text-transform: uppercase;
    font-size: clamp(2.4rem, 4vw, 3.4rem);
    line-height: 0.9;
  }
  .end-text {
    color: var(--fog);
  }
  .progress {
    height: 2px;
    background: var(--line);
    border-radius: 2px;
    overflow: hidden;
    display: none;
  }
  .projects:global(.is-pinned) .progress {
    display: block;
  }
  .progress i {
    display: block;
    height: 100%;
    background: var(--sodium);
    transform-origin: left;
    transform: scaleX(0);
  }
</style>
