---
import { Image, Picture } from 'astro:assets';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import { langOf, otherLang, paths, sectionIds, slugOf, useT, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  entry: CollectionEntry<'projects'>;
}
const { lang, entry } = Astro.props;
const t = useT(lang);
const { Content } = await render(entry);
const slug = slugOf(entry.id);
const d = entry.data;

const all = (await getCollection('projects', (e) => langOf(e.id) === lang)).sort((a, b) => a.data.order - b.data.order);
const next = all[(all.findIndex((e) => e.id === entry.id) + 1) % all.length];
const links = [
  d.links.repo && { href: d.links.repo, label: t('case.repo') },
  d.links.demo && { href: d.links.demo, label: t('case.demo') },
  d.links.design && { href: d.links.design, label: t('case.design') },
].filter(Boolean) as { href: string; label: string }[];
---

<Base lang={lang} altHref={paths.project(otherLang(lang), slug)} title={d.title} description={d.summary}>
  <article class="case">
    <header class="head wrap">
      <a class="back" href={`${paths.home(lang)}#${sectionIds[lang].projects}`}><span aria-hidden="true">←</span> {t('case.back')}</a>
      <p class="eyebrow">{d.platform}</p>
      <h1 class="display" style={`view-transition-name: title-${slug}`}>{d.title}</h1>
      <p class="lede">{d.summary}</p>
    </header>

    <figure class="cover wrap">
      <div class={`cover-media fit-${d.coverFit}`} style={`view-transition-name: media-${slug}`}>
        <Picture
          src={d.cover}
          alt={d.coverAlt}
          formats={['avif', 'webp']}
          widths={[640, 1024, 1600]}
          sizes="(max-width: 1320px) 100vw, 1320px"
          loading="eager"
          fetchpriority="high"
        />
      </div>
      {d.coverIsStock && <figcaption>{t('case.stockNote')}</figcaption>}
    </figure>

    <div class="body wrap">
      <dl class="facts">
        <div>
          <dt>{t('case.platform')}</dt>
          <dd>{d.platform}</dd>
        </div>
        <div>
          <dt>{t('case.stack')}</dt>
          <dd>{d.stack.join(' · ')}</dd>
        </div>
        {
          d.role && (
            <div>
              <dt>{t('case.role')}</dt>
              <dd>{d.role}</dd>
            </div>
          )
        }
        {
          links.length > 0 && (
            <div>
              <dt>{t('case.links')}</dt>
              <dd class="links">
                {links.map((l) => (
                  <a href={l.href} target="_blank" rel="noopener">
                    {l.label} <span aria-hidden="true">↗</span>
                  </a>
                ))}
              </dd>
            </div>
          )
        }
      </dl>
      <div class="prose" data-fog>
        <Content />
      </div>
    </div>

    {
      d.gallery.length > 0 && (
        <section class="gallery wrap" aria-label={t('case.gallery')}>
          {d.gallery.map((g) => (
            <figure>
              <Image src={g.src} alt={g.alt} widths={[600, 1000, 1400]} sizes="(max-width: 900px) 100vw, 900px" />
            </figure>
          ))}
        </section>
      )
    }

    <nav class="next wrap" aria-label={t('case.next')}>
      <a href={paths.project(lang, slugOf(next.id))}>
        <span class="eyebrow">{t('case.next')}</span>
        <span class="display">{next.data.title} <span aria-hidden="true">→</span></span>
      </a>
    </nav>
  </article>
</Base>

<style>
  .case {
    padding-top: calc(var(--nav-h) + clamp(32px, 6vw, 72px));
  }
  .head {
    display: grid;
    gap: 18px;
    justify-items: start;
  }
  .back {
    font-family: var(--f-mono);
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--fog);
    margin-bottom: 12px;
  }
  .back:hover {
    color: var(--sodium);
  }
  h1 {
    font-size: clamp(3.4rem, 11vw, 9.5rem);
    width: fit-content;
  }
  .cover {
    margin-block: clamp(40px, 6vw, 72px) 0;
  }
  .cover-media {
    border-radius: 18px;
    overflow: hidden;
    background: var(--asphalt);
    aspect-ratio: 16 / 9;
    max-height: 78svh;
    width: 100%;
  }
  .cover-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }
  .fit-contain {
    background: radial-gradient(70% 80% at 50% 45%, #2b2a24, var(--asphalt));
  }
  .fit-contain :global(img) {
    object-fit: contain;
    object-position: center;
    padding: 4%;
  }
  figcaption {
    margin-top: 10px;
    font-family: var(--f-mono);
    font-size: 11.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fog-dim);
  }
  .body {
    display: grid;
    gap: 48px;
    padding-block: clamp(56px, 8vw, 104px);
  }
  @media (min-width: 900px) {
    .body {
      grid-template-columns: minmax(0, 300px) minmax(0, 1fr);
      gap: 80px;
    }
  }
  .facts {
    margin: 0;
    align-self: start;
    border-top: 1px solid var(--line);
  }
  .facts div {
    display: grid;
    gap: 4px;
    padding-block: 14px;
    border-bottom: 1px solid var(--line);
  }
  dt {
    font-family: var(--f-mono);
    font-size: 11.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fog-dim);
  }
  dd {
    margin: 0;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 16px;
  }
  .links a {
    color: var(--sodium);
  }
  .prose {
    max-width: 68ch;
    font-size: 18px;
    color: var(--fog);
  }
  .prose :global(h2) {
    font-family: var(--f-display);
    font-weight: 700;
    text-transform: uppercase;
    font-size: clamp(1.8rem, 3.4vw, 2.6rem);
    line-height: 1;
    color: var(--bone);
    margin: 1.6em 0 0.6em;
  }
  .prose :global(h2:first-child) {
    margin-top: 0;
  }
  .prose :global(p) {
    margin-bottom: 1em;
  }
  .prose :global(ul) {
    padding-left: 1.1em;
    display: grid;
    gap: 0.5em;
  }
  .prose :global(li::marker) {
    color: var(--sodium);
  }
  .gallery {
    display: grid;
    gap: 24px;
    justify-items: center;
    padding-bottom: clamp(56px, 8vw, 104px);
  }
  .gallery figure {
    margin: 0;
    max-width: 900px;
    border-radius: 14px;
    overflow: hidden;
    background: var(--asphalt);
  }
  .next {
    border-top: 1px solid var(--line);
    padding-block: clamp(48px, 8vw, 96px);
  }
  .next a {
    display: grid;
    gap: 14px;
    text-decoration: none;
  }
  .next .display {
    font-size: clamp(2.6rem, 8vw, 6.5rem);
    transition: color 0.3s;
  }
  .next a:hover .display {
    color: var(--sodium);
  }
</style>
