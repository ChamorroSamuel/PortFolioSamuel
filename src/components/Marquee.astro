---
import { skills } from '../data/site';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const second =
  lang === 'es'
    ? ['Lima, Perú', 'Ingeniería de Software UPC', 'Web', 'Móvil', 'IoT', 'IA']
    : ['Lima, Peru', 'Software Engineering UPC', 'Web', 'Mobile', 'IoT', 'AI'];
const rows = [
  { words: skills, dir: 1, outline: false },
  { words: second, dir: -1, outline: true },
];
---

<div class="marquee" data-marquee aria-hidden="true">
  {
    rows.map((row) => (
      <div class:list={['row', { outline: row.outline }]} data-marquee-row data-dir={row.dir}>
        <div class="track" data-marquee-track>
          {[0, 1].map(() => (
            <span class="chunk">
              {row.words.map((w) => (
                <span class="item">
                  {w}
                  <em>·</em>
                </span>
              ))}
            </span>
          ))}
        </div>
      </div>
    ))
  }
</div>

<style>
  .marquee {
    display: grid;
    gap: 2px;
    padding-block: clamp(24px, 4vw, 48px);
    border-block: 1px solid var(--line);
    overflow: hidden;
    user-select: none;
  }
  .row {
    overflow: hidden;
    white-space: nowrap;
  }
  .track {
    display: inline-flex;
    will-change: transform;
  }
  .chunk {
    display: inline-flex;
    font-family: var(--f-display);
    font-weight: 700;
    text-transform: uppercase;
    font-size: clamp(2.6rem, 8vw, 6.4rem);
    line-height: 1.02;
  }
  .item {
    display: inline-flex;
    gap: 0.3em;
    padding-right: 0.3em;
  }
  em {
    font-style: normal;
    color: var(--sodium);
  }
  .outline .chunk {
    color: transparent;
    -webkit-text-stroke: 1.2px var(--fog-dim);
  }
  .outline em {
    color: transparent;
  }
</style>
