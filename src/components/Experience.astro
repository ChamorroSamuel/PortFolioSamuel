---
import { experience } from '../data/site';
import { sectionIds, useT, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
---

<section class="section" id={sectionIds[lang].experience} aria-labelledby="exp-title">
  <div class="wrap">
    <header class="section-head">
      <p class="eyebrow">{t('experience.eyebrow')}</p>
      <h2 id="exp-title" class="display" data-fog>{t('experience.title')}</h2>
    </header>

    <div class="timeline" data-timeline>
      <span class="rail" aria-hidden="true"></span>
      <span class="fill" data-timeline-fill aria-hidden="true"></span>
      <ol>
        {
          experience.map((e) => (
            <li data-timeline-item>
              <p class="period">{e.period}</p>
              <div class="body">
                <h3>{e.title[lang]}</h3>
                <p class="org">{e.org[lang]}</p>
                {e.detail && <p class="detail">{e.detail[lang]}</p>}
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .timeline {
    position: relative;
    max-width: 980px;
  }
  .rail,
  .fill {
    position: absolute;
    left: 7px;
    top: 10px;
    bottom: 10px;
    width: 2px;
    background: var(--line);
  }
  .fill {
    background: var(--sodium);
    transform-origin: top;
  }
  ol {
    list-style: none;
    margin: 0;
    padding: 0 0 0 44px;
    display: grid;
    gap: clamp(32px, 5vw, 56px);
  }
  li {
    position: relative;
    display: grid;
    gap: 6px 32px;
  }
  @media (min-width: 760px) {
    li {
      grid-template-columns: 150px minmax(0, 1fr);
    }
  }
  li::before {
    content: '';
    position: absolute;
    left: -44px;
    top: 8px;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--sodium);
    border: 2px solid var(--sodium);
    box-shadow: 0 0 0 6px var(--sodium-soft);
    transition: background-color 0.35s, border-color 0.35s, box-shadow 0.35s;
  }
  .period {
    font-family: var(--f-mono);
    font-size: 13px;
    color: var(--sodium);
    padding-top: 4px;
    font-variant-numeric: tabular-nums;
    transition: color 0.35s;
  }
  h3 {
    font-family: var(--f-display);
    font-weight: 700;
    text-transform: uppercase;
    font-size: clamp(1.6rem, 3.2vw, 2.4rem);
    line-height: 1;
    transition: color 0.35s;
  }
  .org {
    color: var(--bone);
    margin-top: 6px;
  }
  .detail {
    color: var(--fog);
    font-size: 15.5px;
    max-width: 60ch;
    margin-top: 4px;
  }

  /* Con JS: los hitos se apagan hasta que la línea llega a ellos. */
  .timeline:global(.is-armed) li:not(.is-on)::before {
    background: var(--night);
    border-color: var(--fog-dim);
    box-shadow: none;
  }
  .timeline:global(.is-armed) li:not(.is-on) .period {
    color: var(--fog-dim);
  }
  .timeline:global(.is-armed) li:not(.is-on) h3 {
    color: var(--fog-dim);
  }
</style>
