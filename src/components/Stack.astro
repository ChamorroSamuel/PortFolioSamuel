---
import type { CollectionEntry } from 'astro:content';
import { skills } from '../data/site';
import { paths, sectionIds, slugOf, useT, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  projects: CollectionEntry<'projects'>[];
}
const { lang, projects } = Astro.props;
const t = useT(lang);
const used = new Set(projects.flatMap((p) => p.data.stack));
// Primero las del orden definido en site.ts, luego cualquier otra que aparezca en los proyectos.
const graphSkills = [...skills.filter((s) => used.has(s)), ...[...used].filter((s) => !skills.includes(s))];
---

<section class="section" id={sectionIds[lang].stack} aria-labelledby="stack-title">
  <div class="wrap">
    <header class="section-head">
      <p class="eyebrow">{t('stack.eyebrow')}</p>
      <h2 id="stack-title" class="display" data-fog>{t('stack.title')}</h2>
      <p class="lede">{t('stack.hint')}</p>
    </header>

    <div class="graph" data-graph>
      <svg class="lines" data-graph-lines aria-hidden="true"></svg>
      <ul class="col">
        {
          graphSkills.map((s) => (
            <li>
              <button type="button" class="skill" data-skill={s} aria-pressed="false">
                {s}
              </button>
            </li>
          ))
        }
      </ul>
      <ul class="col">
        {
          projects.map((p) => (
            <li>
              <a class="proj" href={paths.project(lang, slugOf(p.id))} data-project={slugOf(p.id)} data-stack={p.data.stack.join('|')}>
                <span>{p.data.title}</span>
                <small>{p.data.platform}</small>
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <p class="also"><span>{t('stack.also')}</span> {t('stack.alsoList')}</p>
  </div>
</section>

<style>
  .graph {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, auto) minmax(0, 1fr);
    column-gap: clamp(48px, 14vw, 240px);
    align-items: center;
  }
  .lines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }
  .lines :global(path) {
    fill: none;
    stroke: var(--sodium);
    stroke-width: 1.5;
    stroke-dasharray: var(--len);
    stroke-dashoffset: var(--len);
    animation: draw 0.7s var(--ease) forwards;
  }
  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .lines :global(path) {
      animation: none;
      stroke-dashoffset: 0;
    }
  }
  .col {
    position: relative;
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 4px;
  }
  .skill {
    background: none;
    border: 0;
    padding: 2px 0;
    cursor: pointer;
    text-align: left;
    font-family: var(--f-display);
    font-weight: 700;
    text-transform: uppercase;
    font-size: clamp(1.6rem, 4.2vw, 3.2rem);
    line-height: 1;
    color: var(--fog-dim);
    transition: color 0.25s;
  }
  .skill:hover,
  .skill:global(.is-on) {
    color: var(--sodium);
  }
  .proj {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 2px 12px;
    padding: 12px 0;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
    color: var(--fog);
    transition: color 0.25s, padding-left 0.35s var(--ease);
  }
  .proj span {
    font-size: clamp(1.05rem, 1.8vw, 1.35rem);
    font-weight: 500;
  }
  .proj small {
    font-family: var(--f-mono);
    font-size: 11.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fog-dim);
  }
  .proj:hover,
  .proj:global(.is-on) {
    color: var(--bone);
    padding-left: 10px;
  }
  .proj:global(.is-on) small {
    color: var(--sodium);
  }
  .also {
    margin-top: 40px;
    color: var(--fog);
    font-size: 15px;
  }
  .also span {
    font-family: var(--f-mono);
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fog-dim);
    margin-right: 10px;
  }
</style>
